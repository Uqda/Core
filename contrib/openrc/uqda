#!/sbin/openrc-run

description="Uqda Core - an independently maintained, hardened and modernized implementation compatible with the existing Yggdrasil network."

CONFFILE="/etc/uqda/uqda.conf"
pidfile="/run/${RC_SVCNAME}.pid"

command="/usr/bin/uqda"

depend() {
	use net dns logger
}

start_pre() {
	if [ ! -f "${CONFFILE}" ]; then
		eerror "Missing ${CONFFILE}; create or migrate your persistent identity before starting Uqda"
		return 1
	fi
	"${command}" -useconffile "${CONFFILE}" -checkconf || return 1

	if [ ! -e /dev/net/tun ]; then
		ebegin "Inserting TUN module"
		if ! modprobe tun;  then
			eerror "Failed to insert TUN kernel module"
			exit 1
		fi
	fi
}

start() {
	ebegin "Starting ${RC_SVCNAME}"
	start-stop-daemon --start --quiet \
		--pidfile "${pidfile}" \
		--make-pidfile \
		--background \
		--stdout /var/log/uqda.stdout.log \
		--stderr /var/log/uqda.stderr.log \
		--exec "${command}" -- -useconffile "${CONFFILE}"
	eend $?
}

stop() {
	ebegin "Stopping ${RC_SVCNAME}"
	start-stop-daemon --stop --pidfile "${pidfile}" --exec "${command}"
	eend $?
}
