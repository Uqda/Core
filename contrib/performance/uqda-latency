#!/bin/sh
# Measure UQDA end-to-end latency using percentiles rather than one ping.

set -eu

TARGET_MS=20
COUNT=20

say() { printf '%s\n' "[UQDA latency] $*"; }
die() { printf '%s\n' "[UQDA latency] ERROR: $*" >&2; exit 1; }

usage() {
	cat <<'EOF'
Usage:
  uqda-latency ADDRESS [--target-ms N] [--count N]
  uqda-latency peers

Reports loss, minimum, average, p50, p95, maximum, and successive-sample
jitter. Exit status is 0 only when all samples return and p95 meets the target;
2 means the target was missed.
EOF
}

[ "$#" -gt 0 ] || { usage; exit 1; }
if [ "$1" = peers ]; then
	command -v uqdactl >/dev/null 2>&1 || die "uqdactl was not found"
	exec uqdactl getPeers sort=latency
fi
DESTINATION=$1
shift

while [ "$#" -gt 0 ]; do
	case "$1" in
		--target-ms) [ "$#" -ge 2 ] || die "--target-ms needs a value"; TARGET_MS=$2; shift 2 ;;
		--count) [ "$#" -ge 2 ] || die "--count needs a value"; COUNT=$2; shift 2 ;;
		-h|--help) usage; exit 0 ;;
		*) die "unknown option: $1" ;;
	esac
done

case "$TARGET_MS" in ''|*[!0-9.]*|.*|*.*.*) die "target must be a positive number" ;; esac
case "$COUNT" in ''|*[!0-9]*) die "count must be a positive integer" ;; esac
awk -v n="$TARGET_MS" 'BEGIN { exit !(n > 0) }' || die "target must be greater than zero"
[ "$COUNT" -ge 3 ] && [ "$COUNT" -le 200 ] || die "count must be between 3 and 200"

TMP_BASE=${TMPDIR:-/tmp}
[ -d "$TMP_BASE" ] || TMP_BASE=.
TMP_DIR=$(mktemp -d "$TMP_BASE/uqda-latency.XXXXXX") || die "could not create temporary directory"
trap 'rm -rf "$TMP_DIR"' EXIT HUP INT TERM
RAW=$TMP_DIR/ping.txt
TIMES=$TMP_DIR/times.txt
SORTED=$TMP_DIR/sorted.txt

if [ -n "${UQDA_LATENCY_PING_OUTPUT:-}" ]; then
	printf '%s\n' "$UQDA_LATENCY_PING_OUTPUT" >"$RAW"
else
	if command -v ping >/dev/null 2>&1 && ping -6 -n -c 1 "$DESTINATION" >/dev/null 2>&1; then
		ping -6 -n -c "$COUNT" "$DESTINATION" >"$RAW" 2>&1 || true
	elif command -v ping6 >/dev/null 2>&1; then
		ping6 -n -c "$COUNT" "$DESTINATION" >"$RAW" 2>&1 || true
	else
		die "no IPv6-capable ping command was found"
	fi
fi

sed -n 's/.*time[=<]\([0-9][0-9.]*\).*/\1/p' "$RAW" >"$TIMES"
RECEIVED=$(wc -l <"$TIMES" | tr -d ' ')
[ "$RECEIVED" -gt 0 ] || { sed -n '1,12p' "$RAW" >&2; die "no ping replies were received"; }
sort -n "$TIMES" >"$SORTED"

STATS=$(awk '
  NR == 1 { min=$1 }
  { values[NR]=$1; sum+=$1; max=$1 }
  END {
    p50=int((NR*50+99)/100); p95=int((NR*95+99)/100)
    printf "%.3f %.3f %.3f %.3f %.3f", min, sum/NR, values[p50], values[p95], max
  }
' "$SORTED")
set -- $STATS
MIN=$1 AVG=$2 P50=$3 P95=$4 MAX=$5
JITTER=$(awk 'NR>1 { d=$1-prev; if (d<0) d=-d; sum+=d; n++ } { prev=$1 } END { if(n) printf "%.3f",sum/n; else print "0.000" }' "$TIMES")
LOSS=$(awk -v sent="$COUNT" -v received="$RECEIVED" 'BEGIN { printf "%.1f", 100*(sent-received)/sent }')

say "destination=$DESTINATION samples=$RECEIVED/$COUNT loss=${LOSS}% target_p95<=${TARGET_MS}ms"
say "min=${MIN}ms avg=${AVG}ms p50=${P50}ms p95=${P95}ms max=${MAX}ms jitter=${JITTER}ms"

if [ "$RECEIVED" -ne "$COUNT" ]; then
	say "FAIL: packet loss prevents a low-latency pass"
	exit 2
fi
if awk -v p95="$P95" -v target="$TARGET_MS" 'BEGIN { exit !(p95 <= target) }'; then
	say "PASS: p95 meets the latency target"
	exit 0
fi
say "WARN: p95 exceeds the target; inspect direct-peer RTT, path, Wi-Fi and loaded-link queueing"
exit 2
