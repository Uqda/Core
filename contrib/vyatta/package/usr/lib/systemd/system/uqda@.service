[Unit]
Description=UQDA mesh interface %i
Wants=network-online.target
After=network-online.target
ConditionPathExists=/config/uqda.%i.conf

[Service]
Group=vyattacfg
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
SyslogIdentifier=uqda
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ExecStart=/usr/local/bin/uqda -useconffile /config/uqda.%i.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
