[Unit]
Description=Uqda Core
Wants=network-online.target
After=network-online.target

[Service]
ExecStartPre=/usr/bin/uqda -useconffile /etc/uqda/uqda.conf -checkconf
Group=uqda
ProtectHome=true
ProtectSystem=strict
NoNewPrivileges=true
RuntimeDirectory=uqda
ReadWritePaths=/var/run/uqda/ /run/uqda/
ReadOnlyPaths=/etc/uqda
SyslogIdentifier=uqda
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ExecStartPre=+-/sbin/modprobe tun
ExecStart=/usr/bin/uqda -useconffile /etc/uqda/uqda.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
