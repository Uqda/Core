[Unit]
Description=UQDA default config generator
ConditionPathExists=|!/etc/uqda/uqda.conf
ConditionFileNotEmpty=|!/etc/uqda/uqda.conf
Wants=local-fs.target
After=local-fs.target

[Service]
Type=oneshot
Group=root
UMask=077
StandardOutput=file:/etc/uqda/uqda.conf
ExecStartPre=/usr/bin/install -d -m 0700 -o root -g root /etc/uqda
ExecStart=/usr/bin/uqda -genconf
ExecStartPost=/usr/bin/chown root:root /etc/uqda /etc/uqda/uqda.conf
ExecStartPost=/usr/bin/chmod 0700 /etc/uqda
ExecStartPost=/usr/bin/chmod 0600 /etc/uqda/uqda.conf
